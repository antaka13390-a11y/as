<Window x:Class="CyberHub.ClientLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CYBER HUB"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Width="1920"
        Height="1080">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail (Customer-Only: Zero Admin Controls) -->
        <Border Grid.Column="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,1,0" Padding="24,32">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,36">
                    <TextBlock Text="CYBER HUB" FontFamily="Segoe UI Black" FontSize="26" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="GAME LAUNCHER" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="Home" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Home" />
                    <Button Content="All Games" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AllGames" />
                    <Button Content="Favorites" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Favorites" />
                    <Button Content="Recently Played" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="RecentlyPlayed" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding CatalogSourceLabel}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <Button Content="Sync Catalog" Style="{StaticResource NavButtonStyle}" Margin="0,10,0,0" Command="{Binding RefreshCatalogCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Viewport -->
        <Grid Grid.Column="1" Margin="36,28,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Search & Category Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{Binding SectionTitle}" FontFamily="Segoe UI Bold" FontSize="28" VerticalAlignment="Center" />

                <Border DockPanel.Dock="Right" Width="360" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0"
                             FontSize="14"
                             CaretBrush="{StaticResource AccentCyanBrush}" />
                </Border>
            </DockPanel>

            <!-- Offline / Launch Feedback Banner -->
            <Border Grid.Row="1"
                    Background="#1D162B"
                    BorderBrush="{StaticResource AccentPurpleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10"
                    Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage.Length, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>

            <!-- Scrollable Content Area -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Featured Hero Banner -->
                    <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="14" Height="340" Margin="0,0,0,28" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding FeaturedGame.ResolvedHeroUri}" Stretch="UniformToFill" Opacity="0.48" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#EE08090D" Offset="0.0" />
                                        <GradientStop Color="#9908090D" Offset="0.55" />
                                        <GradientStop Color="#2208090D" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel VerticalAlignment="Center" Margin="44,0,44,0" MaxWidth="680" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding FeaturedGame.Entry.Category}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Segoe UI Semibold" />
                                <TextBlock Text="{Binding FeaturedGame.Entry.Name}" FontFamily="Segoe UI Black" FontSize="42" Margin="0,6,0,10" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FeaturedGame.Entry.Description}" FontSize="15" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="64" Margin="0,0,0,22" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="PLAY NOW" Style="{StaticResource PlayCtaButtonStyle}" Command="{Binding PlayGameCommand}" CommandParameter="{Binding FeaturedGame}" />
                                    <Button Content="Details" Style="{StaticResource NavButtonStyle}" Margin="14,0,0,0" Command="{Binding SelectGameCommand}" CommandParameter="{Binding FeaturedGame}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Category Filter Strip -->
                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Margin="0,0,10,0"
                                        Padding="16,8"
                                        Background="{StaticResource BgElevatedBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Large Game Cover Artwork Grid -->
                    <ItemsControl ItemsSource="{Binding FilteredGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="252" Height="380" Margin="0,0,22,22" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="285" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Image Grid.Row="0" Source="{Binding ResolvedCoverUri}" Stretch="UniformToFill" />

                                        <StackPanel Grid.Row="1" Margin="14,12,14,12">
                                            <TextBlock Text="{Binding Entry.Name}" FontFamily="Segoe UI Semibold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Entry.Category}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Game Details Slide-Over Drawer -->
        <Border Grid.Column="1"
                HorizontalAlignment="Right"
                Width="460"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderHairlineBrush}"
                BorderThickness="1,0,0,0"
                Padding="32"
                Visibility="{Binding SelectedGame, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="Close" Style="{StaticResource NavButtonStyle}" Command="{Binding CloseDetailsCommand}" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
                    <Button Content="PLAY GAME" Style="{StaticResource PlayCtaButtonStyle}" Command="{Binding PlayGameCommand}" CommandParameter="{Binding SelectedGame}" />
                    <Button Content="Toggle Favorite" Style="{StaticResource NavButtonStyle}" Margin="0,10,0,0" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedGame}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Height="260" CornerRadius="10" ClipToBounds="True" Margin="0,16,0,20" Background="{StaticResource BgElevatedBrush}">
                            <Image Source="{Binding SelectedGame.ResolvedCoverUri}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{Binding SelectedGame.Entry.Name}" FontFamily="Segoe UI Bold" FontSize="26" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedGame.Entry.Category}" FontSize="13" Foreground="{StaticResource AccentCyanBrush}" Margin="0,6,0,14" />
                        <TextBlock Text="{Binding SelectedGame.Entry.Description}" FontSize="14" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="22" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
