<UserControl x:Class="CyberHub.AdminPanel.Views.GameScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0F16"
             Foreground="#F8FAFC">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Storage Folder Config & Background Scan Controls -->
        <Border Grid.Row="0" Background="#11131B" BorderBrush="#262A3B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Configured CCBoot / SMB / UNC Storage Folders (Read-Only Scan)" FontFamily="Segoe UI Bold" FontSize="13" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="Steam Manifests" IsChecked="{Binding Scanner.IncludeSteamManifests}" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <CheckBox Content="Riot Metadata" IsChecked="{Binding Scanner.IncludeRiotMetadata}" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <CheckBox Content="Auto Search Cover Art" IsChecked="{Binding Scanner.SearchCoverArt}" Foreground="#06B6D4" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Button Content="{Binding Loc[Scan.Start]}" Padding="14,7" Margin="0,0,8,0" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="StartScan_Click" />
                        <Button Content="{Binding Loc[Scan.Cancel]}" Padding="12,7" Background="#7F1D1D" Foreground="#FEE2E2" BorderThickness="0" Click="CancelScan_Click" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Scanner.StorageTargets}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#181B26" BorderBrush="#2A2F45" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Location.DisplayName}" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Location.UncRootPath}" FontSize="11" Foreground="#94A3B8" Margin="8,0,8,0" VerticalAlignment="Center" />
                                    <Button Content="×" Padding="6,0" Background="Transparent" Foreground="#FCA5A5" BorderThickness="0" Click="DeleteStorage_Click" Tag="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Scanner.NewLocationName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Display Name" Height="28" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="6,4" />
                    <TextBox Grid.Column="2" Text="{Binding Scanner.NewLocationPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="UNC or Server Path (e.g., \\CCBOOT-SRV\Games\Epic)" Height="28" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="6,4" />
                    <Button Grid.Column="4" Content="{Binding Loc[Scan.AddStorage]}" Padding="12,5" Background="#1E293B" Foreground="#06B6D4" BorderThickness="0" Click="AddStorage_Click" />
                </Grid>

                <TextBlock Text="{Binding Scanner.ScanProgressSummary}" FontSize="12" Foreground="#06B6D4" />
            </StackPanel>
        </Border>

        <!-- Row 1: Candidate Results List + Detailed Artwork & Metadata Inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Candidate List -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Scanner.Candidates}"
                     SelectedItem="{Binding Scanner.SelectedCandidate}"
                     Background="#11131B"
                     Foreground="#F8FAFC"
                     BorderBrush="#262A3B">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="2" Background="#151824" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Grid.Column="1" Width="44" Height="62" Background="#090B10" CornerRadius="4" ClipToBounds="True" Margin="0,0,10,0">
                                    <Image Source="{Binding SelectedCoverUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EditableName}" FontFamily="Segoe UI Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ConfidenceBadge}" FontSize="11" Foreground="#06B6D4" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Source.DuplicateReason}" FontSize="11" Foreground="#FBBF24" Visibility="{Binding Source.IsDuplicate, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="{Binding DataContext.Loc[Scan.IgnoreCandidate], RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Click="IgnoreCandidate_Click" Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected Candidate Inspector & Cover Art Manager -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">
                    <TextBlock Text="Candidate Title" FontSize="11" Foreground="#94A3B8" />
                    <TextBox Text="{Binding Scanner.SelectedCandidate.EditableName, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,10" Background="#181B26" Foreground="#F8FAFC" Padding="8,4" />

                    <TextBlock Text="Detected Executable Path (Read-Only)" FontSize="11" Foreground="#94A3B8" />
                    <TextBox Text="{Binding Scanner.SelectedCandidate.Source.ExecutablePath, Mode=OneWay}" IsReadOnly="True" Height="30" Margin="0,2,0,10" Background="#0B0D14" Foreground="#94A3B8" Padding="8,4" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Online / Offline Mode" FontSize="11" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding Scanner.NetworkModes}" SelectedItem="{Binding Scanner.SelectedCandidate.NetworkMode}" Height="30" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Developer" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Scanner.SelectedCandidate.Developer, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0" Background="#181B26" Foreground="#F8FAFC" Padding="8,4" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Metadata Summary" FontSize="11" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding Scanner.SelectedCandidate.MetadataLine}" FontSize="12" Foreground="#06B6D4" Margin="0,2,0,8" />
                    <TextBox Text="{Binding Scanner.SelectedCandidate.Description, UpdateSourceTrigger=PropertyChanged}" Height="56" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10" Background="#181B26" Foreground="#F8FAFC" Padding="8,4" />

                    <TextBlock Text="Assign Categories Before Import" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Scanner.SelectedCandidate.CandidateCategories}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Foreground="#F8FAFC" Margin="0,0,14,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Automatic Cover Art Search & Manual Upload -->
                    <Border Background="#11131B" BorderBrush="#262A3B" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Cover Artwork Manager (JPG / PNG / WebP)" FontFamily="Segoe UI Bold" FontSize="12" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{Binding Loc[Scan.SearchArtwork]}" Padding="10,5" Margin="6,0,6,0" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Click="SearchArtwork_Click" />
                                    <Button Content="Upload..." Padding="10,5" Margin="0,0,6,0" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Click="UploadArtwork_Click" />
                                    <Button Content="{Binding Loc[Scan.RemoveArtwork]}" Padding="10,5" Background="#7F1D1D" Foreground="#FEE2E2" BorderThickness="0" Click="RemoveArtwork_Click" />
                                </StackPanel>
                                <TextBox Text="{Binding Scanner.CoverSearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="28" Background="#181B26" Foreground="#F8FAFC" Padding="8,4" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Scanner.SelectedCandidate.ArtworkOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,8" Padding="4" Background="#181B26" BorderBrush="#2D3348" BorderThickness="1" Click="SelectArtworkCandidate_Click" Tag="{Binding}">
                                            <StackPanel Width="94">
                                                <Image Source="{Binding ImageUrl}" Height="124" Stretch="UniformToFill" />
                                                <TextBlock Text="{Binding SourceName}" FontSize="10" Foreground="#CBD5E1" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Row 2: Confirmation Import Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Note: Scanning is strictly read-only. Existing administrator-edited games are never overwritten." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="{Binding Loc[Scan.ImportSelected]}" Padding="18,9" Background="#10B981" Foreground="#06281E" FontFamily="Segoe UI Bold" BorderThickness="0" Click="ImportSelected_Click" />
        </DockPanel>
    </Grid>
</UserControl>
