<UserControl x:Class="CyberHub.AdminPanel.Views.AppearanceThemeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0F16"
             Foreground="#F8FAFC">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: 6-Tab Theme & Branding Editor + Publish Toolbar -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <!-- Bottom Action Toolbar -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Content="{Binding Loc[Theme.Preview]}" Padding="12,8" Margin="0,0,8,6" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Click="PreviewDraft_Click" />
                <Button Content="{Binding Loc[Theme.SaveDraft]}" Padding="12,8" Margin="0,0,8,6" Background="#0F766E" Foreground="#FFFFFF" BorderThickness="0" Click="SaveDraft_Click" />
                <Button Content="{Binding Loc[Theme.Publish]}" Padding="14,8" Margin="0,0,8,6" Background="#8B5CF6" Foreground="#FFFFFF" FontFamily="Segoe UI Bold" BorderThickness="0" Click="PublishTheme_Click" />
                <Button Content="{Binding Loc[Theme.Reset]}" Padding="12,8" Margin="0,0,8,6" Background="#1E293B" Foreground="#CBD5E1" BorderThickness="0" Click="ResetChanges_Click" />
                <Button Content="{Binding Loc[Theme.RestoreDefault]}" Padding="12,8" Margin="0,0,0,6" Background="#7F1D1D" Foreground="#FEE2E2" BorderThickness="0" Click="RestoreDefault_Click" />
            </WrapPanel>

            <TabControl Background="#11131B" BorderBrush="#262A3B">
                <!-- Subtab A: Presets & Theme Manager -->
                <TabItem Header="{Binding Loc[Theme.Presets]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Built-in Presets (Click to Apply to Draft)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="Neon Purple" Tag="NeonPurple" Padding="10,6" Margin="0,0,6,6" Background="#2E1E59" Foreground="#F8FAFC" Click="ApplyPreset_Click" />
                                <Button Content="Cyber Blue" Tag="CyberBlue" Padding="10,6" Margin="0,0,6,6" Background="#0B2239" Foreground="#F0F9FF" Click="ApplyPreset_Click" />
                                <Button Content="Dark Red" Tag="DarkRed" Padding="10,6" Margin="0,0,6,6" Background="#3B0D16" Foreground="#FEF2F2" Click="ApplyPreset_Click" />
                                <Button Content="Luxury Gold" Tag="LuxuryGold" Padding="10,6" Margin="0,0,6,6" Background="#2B210E" Foreground="#FEF3C7" Click="ApplyPreset_Click" />
                                <Button Content="Minimal Dark" Tag="MinimalDark" Padding="10,6" Margin="0,0,6,6" Background="#18181B" Foreground="#F4F4F5" Click="ApplyPreset_Click" />
                                <Button Content="Custom Template" Tag="Custom" Padding="10,6" Margin="0,0,6,6" Background="#1E293B" Foreground="#F8FAFC" Click="ApplyPreset_Click" />
                            </WrapPanel>

                            <TextBlock Text="Saved Server Themes" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6" />
                            <ListBox ItemsSource="{Binding SavedThemes}" SelectedItem="{Binding SelectedTheme}" Height="180" Background="#090B10" Foreground="#F8FAFC" BorderBrush="#252A3D" Margin="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock FontFamily="Segoe UI Semibold" FontSize="13">
                                                <Run Text="{Binding Name}" />
                                                <Run Text="  [v" />
                                                <Run Text="{Binding Version}" />
                                                <Run Text="]" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#06B6D4">
                                                <Run Text="Published: " />
                                                <Run Text="{Binding IsPublished}" />
                                                <Run Text=" · Default: " />
                                                <Run Text="{Binding IsDefault}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Create New Theme" FontSize="12" Foreground="#94A3B8" />
                            <DockPanel Margin="0,4,0,10">
                                <Button DockPanel.Dock="Right" Content="Create Theme" Padding="12,6" Margin="8,0,0,0" Background="#8B5CF6" Foreground="#FFFFFF" Click="CreateTheme_Click" />
                                <TextBox Text="{Binding NewThemeName, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                            </DockPanel>

                            <TextBlock Text="{Binding Loc[Theme.Rename]}" FontSize="12" Foreground="#94A3B8" />
                            <DockPanel Margin="0,4,0,10">
                                <Button DockPanel.Dock="Right" Content="{Binding Loc[Theme.Rename]}" Padding="12,6" Margin="8,0,0,0" Background="#1E293B" Foreground="#F8FAFC" Click="RenameTheme_Click" />
                                <TextBox Text="{Binding RenameInput, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                            </DockPanel>

                            <WrapPanel>
                                <Button Content="{Binding Loc[Theme.Duplicate]}" Padding="10,6" Margin="0,0,6,6" Background="#1E293B" Foreground="#F8FAFC" Click="DuplicateTheme_Click" />
                                <Button Content="{Binding Loc[Theme.SetDefault]}" Padding="10,6" Margin="0,0,6,6" Background="#1E293B" Foreground="#06B6D4" Click="SetDefaultTheme_Click" />
                                <Button Content="{Binding Loc[Theme.Delete]}" Padding="10,6" Margin="0,0,0,6" Background="#7F1D1D" Foreground="#FEE2E2" Click="DeleteTheme_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Subtab B: Background & Video Performance -->
                <TabItem Header="{Binding Loc[Theme.Background]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Background Type" FontSize="12" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding BackgroundTypes}" SelectedItem="{Binding Draft.BackgroundType}" Height="30" Margin="0,4,0,10" SelectionChanged="DraftValue_Changed" />

                            <TextBlock Text="Solid Color / Gradient Start / Gradient End (HEX)" FontSize="12" Foreground="#94A3B8" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Draft.SolidBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="2" Text="{Binding Draft.GradientStartColor, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="4" Text="{Binding Draft.GradientEndColor, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                            </Grid>

                            <TextBlock Text="Gradient Angle (deg) / Overlay Opacity (0-1) / Blur Radius (0-40)" FontSize="12" Foreground="#94A3B8" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Draft.GradientAngleDegrees, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="2" Text="{Binding Draft.OverlayOpacity, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="4" Text="{Binding Draft.BlurIntensity, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                            </Grid>

                            <TextBlock Text="Background Image (JPG/PNG/WebP)" FontSize="12" Foreground="#94A3B8" />
                            <DockPanel Margin="0,4,0,10">
                                <Button DockPanel.Dock="Right" Content="{Binding Loc[Theme.UploadBgImage]}" Padding="10,6" Margin="6,0,0,0" Background="#1E293B" Foreground="#F8FAFC" Tag="bgImage" Click="UploadAssetSlot_Click" />
                                <TextBox Text="{Binding Draft.BackgroundImageAssetPath, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                            </DockPanel>

                            <TextBlock Text="Image Scaling &amp; Brightness / Opacity" FontSize="12" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding ImageScalings}" SelectedItem="{Binding Draft.ImageScaling}" Height="30" Margin="0,4,0,10" SelectionChanged="DraftValue_Changed" />

                            <TextBlock Text="Optional Video Background (MP4)" FontSize="12" Foreground="#94A3B8" />
                            <DockPanel Margin="0,4,0,10">
                                <Button DockPanel.Dock="Right" Content="{Binding Loc[Theme.UploadBgVideo]}" Padding="10,6" Margin="6,0,0,0" Background="#1E293B" Foreground="#F8FAFC" Tag="bgVideo" Click="UploadAssetSlot_Click" />
                                <TextBox Text="{Binding Draft.BackgroundVideoAssetPath, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                            </DockPanel>

                            <TextBlock Text="Static Fallback Image (When Video Pauses / Performance Mode)" FontSize="12" Foreground="#94A3B8" />
                            <DockPanel Margin="0,4,0,10">
                                <Button DockPanel.Dock="Right" Content="Upload Fallback..." Padding="10,6" Margin="6,0,0,0" Background="#1E293B" Foreground="#F8FAFC" Tag="bgFallback" Click="UploadAssetSlot_Click" />
                                <TextBox Text="{Binding Draft.StaticFallbackImagePath, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                            </DockPanel>

                            <CheckBox Content="{Binding Loc[Theme.VideoEnabled]}" IsChecked="{Binding Draft.VideoBackgroundEnabled}" Foreground="#F8FAFC" Margin="0,4,0,6" Checked="DraftCheck_Changed" Unchecked="DraftCheck_Changed" />
                            <CheckBox Content="{Binding Loc[Theme.PerfMode]}" IsChecked="{Binding Draft.PerformanceFriendlyMode}" Foreground="#06B6D4" Margin="0,0,0,6" Checked="DraftCheck_Changed" Unchecked="DraftCheck_Changed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Subtab C: Complete Colors -->
                <TabItem Header="{Binding Loc[Theme.Colors]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="All HEX Color Tokens (#RRGGBB) — Updates Live Preview Immediately" FontSize="12" Foreground="#06B6D4" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Primary Accent" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.PrimaryAccentColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Main Background" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.MainBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Game Card Background" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.GameCardBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Primary Text" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.PrimaryTextColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Button Background" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.ButtonBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Hover State" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.HoverStateColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Secondary Accent" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.SecondaryAccentColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Sidebar Background" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.SidebarBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Active Nav Item" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.ActiveNavItemColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Secondary Text" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.SecondaryTextColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Button Text" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.ButtonTextColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />

                                    <TextBlock Text="Border Color" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Draft.BorderColor, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,3" TextChanged="DraftText_Changed" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Subtab D: Game Cards -->
                <TabItem Header="{Binding Loc[Theme.Cards]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Card Layout Style / Shape" FontSize="12" Foreground="#94A3B8" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding CardLayoutStyles}" SelectedItem="{Binding Draft.CardLayoutStyle}" Height="30" SelectionChanged="DraftValue_Changed" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding CardShapes}" SelectedItem="{Binding Draft.CardShape}" Height="30" SelectionChanged="DraftValue_Changed" />
                            </Grid>

                            <TextBlock Text="Grid Columns / Border Radius / Spacing / Title Font Size" FontSize="12" Foreground="#94A3B8" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Draft.GridColumns, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="2" Text="{Binding Draft.CardBorderRadius, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="4" Text="{Binding Draft.CardSpacing, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="6" Text="{Binding Draft.TitleFontSize, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                            </Grid>

                            <TextBlock Text="Card Width / Card Height / Cover Height" FontSize="12" Foreground="#94A3B8" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Draft.CardWidth, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="2" Text="{Binding Draft.CardHeight, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="4" Text="{Binding Draft.CoverImageHeight, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                            </Grid>

                            <TextBlock Text="Hover Animation / Border Effect / Play Button Style" FontSize="12" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding HoverAnimations}" SelectedItem="{Binding Draft.HoverAnimation}" Height="30" Margin="0,4,0,8" SelectionChanged="DraftValue_Changed" />
                            <ComboBox ItemsSource="{Binding BorderEffects}" SelectedItem="{Binding Draft.BorderEffect}" Height="30" Margin="0,0,0,8" SelectionChanged="DraftValue_Changed" />
                            <ComboBox ItemsSource="{Binding PlayButtonStyles}" SelectedItem="{Binding Draft.PlayButtonStyle}" Height="30" Margin="0,0,0,10" SelectionChanged="DraftValue_Changed" />

                            <CheckBox Content="Show Game Description on Card" IsChecked="{Binding Draft.ShowDescriptionOnCard}" Foreground="#F8FAFC" Checked="DraftCheck_Changed" Unchecked="DraftCheck_Changed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Subtab E: Launcher Layout -->
                <TabItem Header="{Binding Loc[Theme.Layout]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Sidebar Position (Start = Right in AR / Left in EN)" FontSize="12" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding SidebarPositions}" SelectedItem="{Binding Draft.SidebarPosition}" Height="30" Margin="0,4,0,10" SelectionChanged="DraftValue_Changed" />

                            <TextBlock Text="Sidebar Width (px) / Header Spacing / Content Spacing" FontSize="12" Foreground="#94A3B8" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Draft.SidebarWidth, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="2" Text="{Binding Draft.HeaderSpacing, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                                <TextBox Grid.Column="4" Text="{Binding Draft.MainContentSpacing, UpdateSourceTrigger=PropertyChanged}" Height="30" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />
                            </Grid>

                            <TextBlock Text="Navigation Style" FontSize="12" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding NavigationStyles}" SelectedItem="{Binding Draft.NavigationStyle}" Height="30" Margin="0,4,0,10" SelectionChanged="DraftValue_Changed" />

                            <TextBlock Text="Logo Position" FontSize="12" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding LogoPositions}" SelectedItem="{Binding Draft.LogoPosition}" Height="30" Margin="0,4,0,10" SelectionChanged="DraftValue_Changed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Subtab F: Branding & Custom Application Name (Part 10) -->
                <TabItem Header="{Binding Loc[Theme.Branding]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[Theme.AppNameEn]}" FontSize="11" Foreground="#06B6D4" />
                            <TextBox Text="{Binding Draft.ApplicationNameEn, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.AppNameAr]}" FontSize="11" Foreground="#06B6D4" />
                            <TextBox Text="{Binding Draft.ApplicationNameAr, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.CafeNameEn]}" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Draft.CyberCafeNameEn, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.CafeNameAr]}" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Draft.CyberCafeNameAr, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.WindowTitleEn]}" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Draft.WindowTitleEn, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.WindowTitleAr]}" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Draft.WindowTitleAr, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.WelcomeTitleEn]}" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Draft.WelcomeTitleEn, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.WelcomeTitleAr]}" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Draft.WelcomeTitleAr, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.LoadingTitleEn]}" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Draft.LoadingScreenTitleEn, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,8" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <TextBlock Text="{Binding Loc[Theme.LoadingTitleAr]}" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Draft.LoadingScreenTitleAr, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,10" Background="#181B26" Foreground="#F8FAFC" Padding="6,4" TextChanged="DraftText_Changed" />

                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="{Binding Loc[Theme.UploadLogo]}" Padding="10,6" Margin="0,0,6,6" Background="#1E293B" Foreground="#F8FAFC" Tag="logo" Click="UploadAssetSlot_Click" />
                                <Button Content="{Binding Loc[Theme.UploadIcon]}" Padding="10,6" Margin="0,0,6,6" Background="#1E293B" Foreground="#F8FAFC" Tag="appIcon" Click="UploadAssetSlot_Click" />
                                <Button Content="{Binding Loc[Theme.UploadLoadingLogo]}" Padding="10,6" Margin="0,0,6,6" Background="#1E293B" Foreground="#F8FAFC" Tag="loadingLogo" Click="UploadAssetSlot_Click" />
                            </WrapPanel>

                            <Button Content="{Binding Loc[Theme.RestoreBranding]}" Padding="12,8" HorizontalAlignment="Left" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Click="RestoreOriginalBranding_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Right Side: Real-Time Customer Launcher Preview -->
        <Border Grid.Column="2" Background="#07080C" BorderBrush="#262A3B" BorderThickness="1" CornerRadius="10" Padding="14">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Theme.LivePreview]}" FontFamily="Segoe UI Bold" FontSize="15" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding PreviewWindowTitle}" FontSize="12" Foreground="#06B6D4" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{Binding Loc[Theme.PreviewAr]}" Padding="10,5" Margin="0,0,6,0" Background="#1E293B" Foreground="#F8FAFC" Click="PreviewAr_Click" />
                        <Button Content="{Binding Loc[Theme.PreviewEn]}" Padding="10,5" Background="#1E293B" Foreground="#06B6D4" Click="PreviewEn_Click" />
                    </StackPanel>
                </DockPanel>

                <!-- Embedded Scaled Customer Launcher Simulation -->
                <Border CornerRadius="8" ClipToBounds="True" Background="{Binding PreviewBackgroundBrush}" FlowDirection="{Binding PreviewFlowDirection}" BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding PreviewBgImageUrl}" Stretch="UniformToFill" Opacity="{Binding Draft.BackgroundOpacity}" Visibility="{Binding HasPreviewBgImage, Converter={StaticResource BoolToVis}}">
                            <Image.Effect>
                                <BlurEffect Radius="{Binding PreviewBlurRadius}" />
                            </Image.Effect>
                        </Image>
                        <Border Background="{Binding PreviewOverlayBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Preview Sidebar -->
                            <Border Grid.Column="0" Background="{Binding PreviewSidebarBrush}" BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Image Source="{Binding PreviewLogoUrl}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,8,0" Visibility="{Binding HasPreviewLogo, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding PreviewAppName}" FontFamily="Segoe UI Black" FontSize="15" Foreground="{Binding PreviewPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PreviewCafeName}" FontSize="10" Foreground="{Binding PreviewSecondaryAccentBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{Binding PreviewActiveNavBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding PreviewHomeLabel}" FontSize="12" Foreground="{Binding PreviewPrimaryTextBrush}" />
                                    </Border>
                                    <Border Padding="10,7">
                                        <TextBlock Text="{Binding PreviewOnlineLabel}" FontSize="12" Foreground="{Binding PreviewSecondaryTextBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Preview Main Content -->
                            <StackPanel Grid.Column="1" Margin="18">
                                <TextBlock Text="{Binding PreviewWelcomeTitle}" FontFamily="Segoe UI Bold" FontSize="18" Foreground="{Binding PreviewPrimaryTextBrush}" Margin="0,0,0,12" />

                                <Border Background="{Binding PreviewCardBrush}" BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1" CornerRadius="{Binding PreviewCardRadius}" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PreviewSampleGame1}" FontFamily="Segoe UI Black" FontSize="20" Foreground="{Binding PreviewPrimaryTextBrush}" />
                                        <TextBlock Text="5v5 Tactical Shooter · Online" FontSize="11" Foreground="{Binding PreviewSecondaryTextBrush}" Margin="0,4,0,10" />
                                        <Button Content="{Binding PreviewPlayLabel}" HorizontalAlignment="Left" Padding="16,7" Background="{Binding PreviewButtonBgBrush}" Foreground="{Binding PreviewButtonTextBrush}" BorderThickness="0" FontFamily="Segoe UI Bold" />
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2">
                                    <Border Background="{Binding PreviewCardBrush}" BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1" CornerRadius="{Binding PreviewCardRadius}" Padding="12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <Border Height="86" Background="{Binding PreviewPrimaryAccentBrush}" Opacity="0.35" CornerRadius="6" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding PreviewSampleGame1}" FontSize="{Binding Draft.TitleFontSize}" Foreground="{Binding PreviewPrimaryTextBrush}" />
                                            <TextBlock Text="Tactical FPS" FontSize="11" Foreground="{Binding PreviewSecondaryTextBrush}" Visibility="{Binding Draft.ShowDescriptionOnCard, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{Binding PreviewCardBrush}" BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1" CornerRadius="{Binding PreviewCardRadius}" Padding="12">
                                        <StackPanel>
                                            <Border Height="86" Background="{Binding PreviewSecondaryAccentBrush}" Opacity="0.35" CornerRadius="6" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding PreviewSampleGame2}" FontSize="{Binding Draft.TitleFontSize}" Foreground="{Binding PreviewPrimaryTextBrush}" />
                                            <TextBlock Text="Arcade Racing" FontSize="11" Foreground="{Binding PreviewSecondaryTextBrush}" Visibility="{Binding Draft.ShowDescriptionOnCard, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
