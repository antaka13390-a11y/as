<Window x:Class="CyberHub.AdminPanel.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CYBER HUB — Administration Console"
        Width="1360"
        Height="860"
        WindowStartupLocation="CenterScreen"
        Background="#090A0F"
        Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CYBER HUB ADMINISTRATION" FontFamily="Segoe UI Black" FontSize="20" />
                <TextBlock Text="Central Library &amp; CCBoot Catalog Manager" FontSize="12" Foreground="#06B6D4" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New Game" Padding="14,8" Margin="0,0,8,0" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="NewGame_Click" />
                <Button Content="Backup SQLite DB" Padding="14,8" Margin="0,0,8,0" Background="#1A1D2B" Foreground="#F8FAFC" BorderBrush="#2D3348" BorderThickness="1" Click="BackupDb_Click" />
                <Button Content="Refresh" Padding="14,8" Background="#1A1D2B" Foreground="#F8FAFC" BorderBrush="#2D3348" BorderThickness="1" Click="Refresh_Click" />
            </StackPanel>
        </DockPanel>

        <!-- Tabs: Game Library vs Activity Logs -->
        <TabControl Grid.Row="1" Background="#11131B" BorderBrush="#262A3B">
            <TabItem Header="Game Library">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Games List -->
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame}"
                             Background="#0D0F16"
                             Foreground="#F8FAFC"
                             BorderBrush="#262A3B"
                             Margin="0,0,16,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="14" />
                                    <TextBlock FontSize="11" Foreground="#94A3B8">
                                        <Run Text="{Binding Category}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding LaunchType}" />
                                        <Run Text=" · Visible: " />
                                        <Run Text="{Binding IsVisible}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Right Editor Form -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Game Configuration" FontFamily="Segoe UI Bold" FontSize="16" Margin="0,0,0,12" />

                            <TextBlock Text="Game Name" FontSize="12" Foreground="#94A3B8" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Category" FontSize="12" Foreground="#94A3B8" />
                                    <ComboBox ItemsSource="{Binding PresetCategories}" Text="{Binding EditCategory}" IsEditable="True" Height="32" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Developer / Publisher" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding EditDeveloper, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Storage Location (UNC)" FontSize="12" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding StorageLocations}" SelectedValuePath="Id" SelectedValue="{Binding EditStorageLocationId}" DisplayMemberPath="DisplayName" Height="32" Margin="0,4,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Launch Type" FontSize="12" Foreground="#94A3B8" />
                                    <ComboBox ItemsSource="{Binding LaunchTypes}" SelectedItem="{Binding EditLaunchType}" Height="32" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Steam AppID / Riot Product ID" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding EditExternalAppId, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="UNC Executable Path (e.g. \\CCBOOT-SRV\Games\CCBoot\Valorant\VALORANT.exe)" FontSize="12" Foreground="#94A3B8" />
                            <TextBox Text="{Binding EditExecutablePath, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Launch Arguments" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding EditLaunchArguments, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Process Name to Monitor (for Launcher Exit)" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding EditProcessNameToMonitor, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Cover Artwork Path / URL" FontSize="12" Foreground="#94A3B8" />
                            <DockPanel Margin="0,4,0,12">
                                <Button DockPanel.Dock="Right" Content="Upload Cover..." Padding="12,6" Margin="8,0,0,0" Background="#1E293B" Foreground="#F8FAFC" Click="UploadCover_Click" />
                                <TextBox Text="{Binding EditCoverImagePath, UpdateSourceTrigger=PropertyChanged}" Height="32" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                            </DockPanel>

                            <TextBlock Text="Description" FontSize="12" Foreground="#94A3B8" />
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,6" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <CheckBox Content="Visible to Clients" IsChecked="{Binding EditIsVisible}" Foreground="#F8FAFC" Margin="0,0,24,0" />
                                <CheckBox Content="Featured on Home Banner" IsChecked="{Binding EditIsFeatured}" Foreground="#F8FAFC" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save Game" Padding="18,10" Margin="0,0,10,0" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="SaveGame_Click" />
                                <Button Content="Toggle Hide / Show" Padding="14,10" Margin="0,0,10,0" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Click="ToggleVisibility_Click" />
                                <Button Content="Remove Library Record Only" Padding="14,10" Background="#7F1D1D" Foreground="#FEE2E2" BorderThickness="0" Click="RemoveRecord_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Activity Audit Logs">
                <DataGrid ItemsSource="{Binding AuditLogs}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#0D0F16"
                          Foreground="#F8FAFC"
                          RowBackground="#11131B"
                          AlternatingRowBackground="#151824"
                          BorderThickness="0"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TimestampUtc}" Width="190" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180" />
                        <DataGridTextColumn Header="Game" Binding="{Binding TargetGameName}" Width="180" />
                        <DataGridTextColumn Header="Workstation" Binding="{Binding WorkstationName}" Width="130" />
                        <DataGridTextColumn Header="Source IP" Binding="{Binding SourceIp}" Width="120" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusBanner}" Margin="0,12,0,0" FontSize="12" Foreground="#06B6D4" />
    </Grid>
</Window>
