<Window x:Class="CyberHub.AdminPanel.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CyberHub.AdminPanel.Views"
        Title="CYBER HUB — Administration"
        Width="1480"
        Height="920"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        Background="#090A0F"
        Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Loc[Admin.Title]}" FontFamily="Segoe UI Black" FontSize="20" />
                <TextBlock Text="{Binding Loc[Admin.Subtitle]}" FontSize="12" Foreground="#06B6D4" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding Loc[Lang.SwitchLabel]}" Padding="14,8" Margin="0,0,8,0" Background="#1A1D2B" Foreground="#06B6D4" BorderBrush="#2D3348" BorderThickness="1" Click="ToggleLang_Click" />
                <Button Content="{Binding Loc[Admin.NewGame]}" Padding="14,8" Margin="0,0,8,0" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="NewGame_Click" />
                <Button Content="{Binding Loc[Admin.BackupDb]}" Padding="14,8" Margin="0,0,8,0" Background="#1A1D2B" Foreground="#F8FAFC" BorderBrush="#2D3348" BorderThickness="1" Click="BackupDb_Click" />
                <Button Content="{Binding Loc[Admin.Refresh]}" Padding="14,8" Margin="0,0,8,0" Background="#1A1D2B" Foreground="#F8FAFC" BorderBrush="#2D3348" BorderThickness="1" Click="Refresh_Click" />
                <Button Content="{Binding Loc[Admin.SignOut]}" Padding="14,8" Background="#7F1D1D" Foreground="#FEE2E2" BorderThickness="0" Click="SecureLogout_Click" />
            </StackPanel>
        </DockPanel>

        <!-- Main Tabs: Game Library (incl. Scan for Games) | Categories | Appearance & Themes | Settings -> Security & Account | Session Recovery | Logs -->
        <TabControl Grid.Row="1" Background="#11131B" BorderBrush="#262A3B">
            <!-- Game Library + Scan for Games -->
            <TabItem Header="{Binding Loc[Admin.TabGames]}">
                <TabControl Background="#0D0F16" BorderBrush="#262A3B" Margin="8">
                    <TabItem Header="Library Manager">
                        <Grid Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0"
                                     ItemsSource="{Binding Games}"
                                     SelectedItem="{Binding SelectedGame}"
                                     Background="#0D0F16"
                                     Foreground="#F8FAFC"
                                     BorderBrush="#262A3B"
                                     Margin="0,0,16,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="14" />
                                            <TextBlock FontSize="11" Foreground="#94A3B8">
                                                <Run Text="{Binding NetworkMode}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding LaunchType}" />
                                                <Run Text=" · Visible: " />
                                                <Run Text="{Binding IsVisible}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[Admin.GameName]}" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Loc[Admin.NetworkClassification]}" FontSize="12" Foreground="#94A3B8" />
                                            <ComboBox ItemsSource="{Binding NetworkModes}" SelectedItem="{Binding EditNetworkMode}" Height="32" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Loc[Admin.Developer]}" FontSize="12" Foreground="#94A3B8" />
                                            <TextBox Text="{Binding EditDeveloper, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Loc[Admin.CategoriesMulti]}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding AssignableCategories}" Margin="0,0,0,12">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Foreground="#F8FAFC" Margin="0,0,16,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Loc[Admin.StorageLocation]}" FontSize="12" Foreground="#94A3B8" />
                                    <ComboBox ItemsSource="{Binding StorageLocations}" SelectedValuePath="Id" SelectedValue="{Binding EditStorageLocationId}" DisplayMemberPath="DisplayName" Height="32" Margin="0,4,0,12" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Loc[Admin.LaunchType]}" FontSize="12" Foreground="#94A3B8" />
                                            <ComboBox ItemsSource="{Binding LaunchTypes}" SelectedItem="{Binding EditLaunchType}" Height="32" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Loc[Admin.ExternalId]}" FontSize="12" Foreground="#94A3B8" />
                                            <TextBox Text="{Binding EditExternalAppId, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Loc[Admin.ExecutablePath]}" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding EditExecutablePath, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Loc[Admin.LaunchArgs]}" FontSize="12" Foreground="#94A3B8" />
                                            <TextBox Text="{Binding EditLaunchArguments, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Loc[Admin.MonitorProcess]}" FontSize="12" Foreground="#94A3B8" />
                                            <TextBox Text="{Binding EditProcessNameToMonitor, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Loc[Admin.CoverPath]}" FontSize="12" Foreground="#94A3B8" />
                                    <DockPanel Margin="0,4,0,12">
                                        <Button DockPanel.Dock="Right" Content="{Binding Loc[Admin.UploadCover]}" Padding="12,6" Margin="8,0,0,0" Background="#1E293B" Foreground="#F8FAFC" Click="UploadCover_Click" />
                                        <TextBox Text="{Binding EditCoverImagePath, UpdateSourceTrigger=PropertyChanged}" Height="32" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Loc[Admin.Description]}" FontSize="12" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,6" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <CheckBox Content="{Binding Loc[Admin.VisibleToClients]}" IsChecked="{Binding EditIsVisible}" Foreground="#F8FAFC" Margin="0,0,24,0" />
                                        <CheckBox Content="{Binding Loc[Admin.FeaturedOnHome]}" IsChecked="{Binding EditIsFeatured}" Foreground="#F8FAFC" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Loc[Admin.Save]}" Padding="18,10" Margin="0,0,10,0" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="SaveGame_Click" />
                                        <Button Content="{Binding Loc[Admin.ToggleVisibility]}" Padding="14,10" Margin="0,0,10,0" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Click="ToggleVisibility_Click" />
                                        <Button Content="{Binding Loc[Admin.DeleteRecordOnly]}" Padding="14,10" Background="#7F1D1D" Foreground="#FEE2E2" BorderThickness="0" Click="RemoveRecord_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding Loc[Scan.TabTitle]}">
                        <views:GameScannerView />
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- Dynamic Categories -->
            <TabItem Header="{Binding Loc[Admin.TabCategories]}">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <Button DockPanel.Dock="Top" Content="{Binding Loc[Admin.NewCategory]}" Padding="12,8" Margin="0,0,0,10" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="NewCategory_Click" />
                        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="#0D0F16" Foreground="#F8FAFC" BorderBrush="#262A3B">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,4">
                                        <TextBlock FontFamily="Segoe UI Semibold" FontSize="14">
                                            <Run Text="{Binding NameAr}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding NameEn}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#94A3B8">
                                            <Run Text="Order: " />
                                            <Run Text="{Binding DisplayOrder}" />
                                            <Run Text=" · Icon: " />
                                            <Run Text="{Binding IconKey}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Loc[Admin.CatNameAr]}" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding CatNameAr, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />

                        <TextBlock Text="{Binding Loc[Admin.CatNameEn]}" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding CatNameEn, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[Admin.CatOrder]}" FontSize="12" Foreground="#94A3B8" />
                                <TextBox Text="{Binding CatDisplayOrder, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[Admin.CatIcon]}" FontSize="12" Foreground="#94A3B8" />
                                <ComboBox ItemsSource="{Binding AvailableIcons}" SelectedItem="{Binding CatIconKey}" Height="32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Loc[Admin.CatBanner]}" FontSize="12" Foreground="#94A3B8" />
                        <TextBox Text="{Binding CatBannerImagePath, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,16" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,4" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Loc[Admin.Save]}" Padding="18,10" Margin="0,0,10,0" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="SaveCategory_Click" />
                            <Button Content="{Binding Loc[Admin.DeleteCategory]}" Padding="14,10" Background="#7F1D1D" Foreground="#FEE2E2" BorderThickness="0" Click="DeleteCategory_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Appearance & Themes + Branding -->
            <TabItem Header="{Binding Loc[Admin.TabThemes]}">
                <views:AppearanceThemeView DataContext="{Binding ThemeEditor}" />
            </TabItem>

            <!-- Settings -> Security & Account -->
            <TabItem Header="{Binding Loc[Admin.TabSecurity]}">
                <StackPanel Margin="24" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Loc[Security.Heading]}" FontFamily="Segoe UI Bold" FontSize="18" Margin="0,0,0,14" />

                    <TextBlock Text="{Binding Loc[Security.CurrentPassword]}" FontSize="12" Foreground="#94A3B8" />
                    <PasswordBox x:Name="CurrentPasswordBox" Height="34" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,6" />

                    <TextBlock Text="{Binding Loc[Security.NewPassword]}" FontSize="12" Foreground="#94A3B8" />
                    <PasswordBox x:Name="NewPasswordBox" Height="34" Margin="0,4,0,6" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,6" PasswordChanged="NewPasswordBox_PasswordChanged" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Loc[Security.Strength]}" FontSize="12" Foreground="#94A3B8" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding PasswordStrengthLabel}" FontSize="12" FontFamily="Segoe UI Bold" Foreground="#06B6D4" />
                    </StackPanel>

                    <TextBlock Text="{Binding Loc[Security.ConfirmPassword]}" FontSize="12" Foreground="#94A3B8" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="34" Margin="0,4,0,16" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,6" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="{Binding Loc[Security.SavePassword]}" Padding="18,10" Margin="0,0,12,0" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="ChangePassword_Click" />
                        <Button Content="{Binding Loc[Admin.SignOut]}" Padding="16,10" Background="#7F1D1D" Foreground="#FEE2E2" BorderThickness="0" Click="SecureLogout_Click" />
                    </StackPanel>

                    <TextBlock Text="{Binding SecurityMessage}" FontSize="13" Foreground="#06B6D4" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <!-- Session Recovery -->
            <TabItem Header="{Binding Loc[Admin.TabSessions]}">
                <StackPanel Margin="20" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Loc[Admin.LocalLockNote]}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding Loc[Admin.TargetStation]}" FontSize="12" Foreground="#94A3B8" />
                    <TextBox Text="{Binding RecoveryStationName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,4,0,12" Background="#181B26" Foreground="#F8FAFC" BorderBrush="#2A2F45" Padding="8,6" />
                    <Button Content="{Binding Loc[Admin.GenerateRecovery]}" Padding="18,10" HorizontalAlignment="Left" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Click="IssueRecovery_Click" />
                    <TextBox Text="{Binding IssuedRecoveryCode}" IsReadOnly="True" Height="38" Margin="0,14,0,0" Background="#0D0F16" Foreground="#06B6D4" BorderBrush="#262A3B" Padding="10,8" FontFamily="Consolas" />
                </StackPanel>
            </TabItem>

            <!-- Activity Audit Logs -->
            <TabItem Header="{Binding Loc[Admin.TabLogs]}">
                <DataGrid ItemsSource="{Binding AuditLogs}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#0D0F16"
                          Foreground="#F8FAFC"
                          RowBackground="#11131B"
                          AlternatingRowBackground="#151824"
                          BorderThickness="0"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TimestampUtc}" Width="190" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180" />
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetGameName}" Width="180" />
                        <DataGridTextColumn Header="Workstation" Binding="{Binding WorkstationName}" Width="130" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusBanner}" Margin="0,12,0,0" FontSize="12" Foreground="#06B6D4" />
    </Grid>
</Window>
